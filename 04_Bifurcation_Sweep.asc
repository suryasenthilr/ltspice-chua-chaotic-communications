Version 4
SHEET 1 2400 1200
* ========================================================
* TITLE BLOCK
* ========================================================
TEXT 80 40 Left 2 ;CHUA'S CIRCUIT CHAOTIC OSCILLATOR - AD712 DUAL BiFET OP-AMP REALIZATION

* ========================================================
* SECTION 1: DC POWER SUPPLIES (+9V / -9V)
* ========================================================
TEXT 80 120 Left 2 ;[DC POWER SUPPLIES]

* Vpos (+9V)
SYMBOL voltage 100 180 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Vpos_src
SYMATTR Value 9
WIRE 100 196 100 160
FLAG 100 160 Vpos
WIRE 100 276 100 310
FLAG 100 310 0

* Vneg (-9V)
SYMBOL voltage 100 360 R0
WINDOW 123 24 16 Left 2
WINDOW 39 24 56 Left 2
SYMATTR InstName Vneg_src
SYMATTR Value 9
WIRE 100 376 100 340
FLAG 100 340 0
WIRE 100 456 100 490
FLAG 100 490 Vneg

* ========================================================
* SECTION 2: CHUA RESONANT LC TANK & BIFURCATION RESISTOR
* ========================================================
TEXT 360 120 Left 2 ;[1. RESONANT LC TANK & TUNING RESISTOR]

* Vc1 Node & C1 (10nF)
FLAG 380 180 Vc1
WIRE 380 180 500 180
SYMBOL cap 364 180 R0
SYMATTR InstName C1
SYMATTR Value 10n
SYMATTR SpiceLine ic=0.1
WIRE 380 244 380 280
FLAG 380 280 0

* R_pot (1.75k)
SYMBOL res 484 164 R0
SYMATTR InstName R_pot
SYMATTR Value {Rval}

* Vc2 Node & C2 (100nF)
FLAG 500 260 Vc2
WIRE 500 260 660 260
SYMBOL cap 644 260 R0
SYMATTR InstName C2
SYMATTR Value 100n
SYMATTR SpiceLine ic=0
WIRE 660 324 660 360
FLAG 660 360 0

* L1 (18mH, Rser=12.5)
WIRE 660 260 820 260
SYMBOL ind 804 244 R0
SYMATTR InstName L1
SYMATTR Value 18m
SYMATTR SpiceLine Rser=12.5 ic=0
WIRE 820 340 820 360
FLAG 820 360 0

* ========================================================
* SECTION 3: CHUA DIODE A1 (INNER NEGATIVE RESISTANCE Ga)
* ========================================================
TEXT 1040 120 Left 2 ;[2. CHUA DIODE: INNER SLOPE (A1)]

* Op-Amp U1 (AD712) placed at (1160, 200)
* In+ = (1160-32, 200+80) = (1128, 280) -> Vc1
* In- = (1160-32, 200+48) = (1128, 248) -> n1
* V+  = (1160+0, 200+32)  = (1160, 232) -> Vpos
* V-  = (1160+0, 200+96)  = (1160, 296) -> Vneg
* OUT = (1160+32, 200+64) = (1192, 264) -> out1
SYMBOL Opamps\\AD712 1160 200 R0
SYMATTR InstName U1
SYMATTR Value AD712
FLAG 1128 280 Vc1
FLAG 1160 232 Vpos
FLAG 1160 296 Vneg
FLAG 1192 264 out1
FLAG 1128 248 n1

* R1 (1k) from n1 to GND: placed at (1040, 320)
* Pin 1 is (1056, 336) -> wire to n1 (1128, 248)
* Pin 2 is (1056, 416) -> 0
WIRE 1128 248 1056 248
WIRE 1056 248 1056 336
SYMBOL res 1040 320 R0
SYMATTR InstName R1
SYMATTR Value 1k
FLAG 1056 416 0

* R2 (6.5k) from n1 to out1: placed at (1140, 320)
* Pin 1 is (1156, 336) -> wire to n1 (1056, 248)
* Pin 2 is (1156, 416) -> wire to out1 (1192, 264)
WIRE 1056 248 1156 248
WIRE 1156 248 1156 336
SYMBOL res 1140 320 R0
SYMATTR InstName R2
SYMATTR Value 6.5k
WIRE 1156 416 1260 416
WIRE 1260 416 1260 264
WIRE 1260 264 1192 264

* R3 (18k) from out1 to Vc1: placed at (1280, 320)
* Pin 1 is (1296, 336) -> wire to out1 (1260, 264)
* Pin 2 is (1296, 416) -> wire to Vc1
WIRE 1260 264 1296 264
WIRE 1296 264 1296 336
SYMBOL res 1280 320 R0
SYMATTR InstName R3
SYMATTR Value 18k
FLAG 1296 416 Vc1

* ========================================================
* SECTION 4: CHUA DIODE A2 (OUTER NEGATIVE RESISTANCE Gb)
* ========================================================
TEXT 1540 120 Left 2 ;[3. CHUA DIODE: OUTER SLOPE (A2)]

* Op-Amp U2 (AD712) placed at (1660, 200)
SYMBOL Opamps\\AD712 1660 200 R0
SYMATTR InstName U2
SYMATTR Value AD712
FLAG 1628 280 Vc1
FLAG 1660 232 Vpos
FLAG 1660 296 Vneg
FLAG 1692 264 out2
FLAG 1628 248 n2

* R4 (2k) from n2 to GND: placed at (1540, 320)
WIRE 1628 248 1556 248
WIRE 1556 248 1556 336
SYMBOL res 1540 320 R0
SYMATTR InstName R4
SYMATTR Value 2k
FLAG 1556 416 0

* R5 (2k) from n2 to out2: placed at (1640, 320)
WIRE 1556 248 1656 248
WIRE 1656 248 1656 336
SYMBOL res 1640 320 R0
SYMATTR InstName R5
SYMATTR Value 2k
WIRE 1656 416 1760 416
WIRE 1760 416 1760 264
WIRE 1760 264 1692 264

* R6 (2.5k) from out2 to Vc1: placed at (1780, 320)
WIRE 1760 264 1796 264
WIRE 1796 264 1796 336
SYMBOL res 1780 320 R0
SYMATTR InstName R6
SYMATTR Value 2.5k
FLAG 1796 416 Vc1

* ========================================================
* SECTION 5: SIMULATION COMMANDS & DIRECTIVES
* ========================================================
TEXT 80 540 Left 2 ;[SIMULATION DIRECTIVES & CONTROLS]
TEXT 80 540 Left 2 !.param Rval=1750
TEXT 80 580 Left 2 !.step param Rval list 1950 1850 1780 1720
TEXT 80 620 Left 2 !.tran 0 45m 0 5u uic
TEXT 80 660 Left 2 !.options method=gear maxstep=5u
TEXT 80 700 Left 2 !.lib ADI1.lib
TEXT 80 740 Left 2 !.ic V(Vc1)=0.1 V(Vc2)=0 I(L1)=0
TEXT 80 760 Left 2 ;INSTRUCTIONS: Run simulation, left-click horizontal axis ('time'), and replace with V(vc1) for the Double Scroll!
